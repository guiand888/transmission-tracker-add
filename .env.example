# Copy to .env and edit. .env is gitignored; never commit it.

# Git tag of guiand888/transmission-tracker-add that Compose builds from.
TRACKER_ADD_TAG=v1.0.0

# host:port of Transmission's RPC endpoint AS SEEN FROM INSIDE this container.
# Same Compose network: transmission:9091 | VPN sidecar: localhost:9091
HOSTPORT=transmission:9091

# Transmission RPC credentials, "user:password". Leave empty if RPC auth is
# off. Prefer TR_AUTH_FILE / a Docker secret over this where possible — see
# the README for why.
TR_AUTH=

# One or more whitespace-separated tracker-list URLs.
TORRENTLIST=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_all.txt

# Seconds between scan passes.
INTERVAL=60

LOG_LEVEL=INFO
TZ=UTC
